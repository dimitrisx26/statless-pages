# ==============================================================================
# statless-pages environment configuration
# ==============================================================================
# Copy this file to .env and customize values as needed.
# Docker Compose and the Python application automatically pick up .env settings.

# Public base URL of your collector (used to generate snippets and cookie scoping)
BASE_URL=http://localhost:8000

# Database URL (SQLite default or PostgreSQL)
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/statless.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://statless:statless@db:5432/statless

# Secret token required to access /stats, /overview, /export, and DELETE /docs
# Recommended: generate with `openssl rand -hex 24`
STATS_TOKEN=

# GDPR Data Controller details (displayed on /privacy notice)
CONTROLLER_NAME=
CONTROLLER_CONTACT=

# Security contact line and policy for /.well-known/security.txt (RFC 9116)
SECURITY_CONTACT=mailto:security@YOUR-DOMAIN.example
SECURITY_POLICY=
# Optional RFC 3339 expiry (defaults to 1 year ahead if omitted)
# SECURITY_EXPIRES=2027-01-01T00:00:00Z

# Data Retention (GDPR Art. 5(1)(e) Storage Limitation)
# Events older than this many days are automatically pruned daily (default: 180).
# Set to 0 to disable automatic pruning.
RETENTION_DAYS=180

# Ephemeral salt rotation window in hours (default: 24)
SALT_ROTATE_HOURS=24

# Set to true ONLY when running behind a trusted reverse proxy (Caddy, Nginx, Cloudflare)
# that manages X-Forwarded-For / X-Real-IP headers.
TRUST_PROXY=false

# Filter crawlers, bots, and link-preview fetches from view counts (default: true)
FILTER_BOTS=true

# Optional server secret for deterministic cross-replica salt derivation
# (HMAC of date). Required for multi-instance deployments behind a load balancer.
# SERVER_SECRET=

# Ingestion rate limit: max events per minute per IP socket (default: 120, 0 disables)
RATE_LIMIT=120

# View deduplication window in minutes per IP-hash (0 = count every view)
VIEW_DEDUPE_MINUTES=0

# Extra origins allowed to frame /embed widget, comma-separated (Notion apex/wildcard by default)
# EMBED_ALLOWED_ORIGINS=https://notion.so,https://*.notion.so,https://docs.example.com
